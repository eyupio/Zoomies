# systemd unit for the Zoomies controller.
#
# Written by `zoomies init`. Edit it if you must, but re-running `zoomies init`
# to upgrade will rewrite it -- put local changes in a drop-in instead:
#   systemctl edit {{.Unit}}
#
# The hardening below is not decoration: the controller needs almost nothing
# from the host, so almost everything is taken away from it.

[Unit]
Description={{.Description}}
Documentation=https://github.com/eyupio/zoomies
After=network-online.target
Wants=network-online.target
{{- if .WantsDocker}}
# Present so a Docker-backed embedded agent starts after the daemon it needs.
After=docker.service
Wants=docker.service
{{- end}}

[Service]
Type=notify
NotifyAccess=main
User={{.User}}
Group={{.Group}}
{{- if .SupplementaryGroups}}
# Membership in this group is what makes the root {{.RuntimeName}} socket usable.
# A rootless socket needs no group; this line is here because one was chosen.
SupplementaryGroups={{join .SupplementaryGroups " "}}
{{- end}}
ExecStart={{.ExecPath}} {{.Command}} --config {{.ConfigFile}}
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec={{.StopTimeout}}
# Long enough for in-flight jobs to be left alone; the controller does not kill
# runners on shutdown.
KillSignal=SIGTERM

{{- if .StandardDirs}}

StateDirectory=zoomies
StateDirectoryMode=0750
ConfigurationDirectory=zoomies
ConfigurationDirectoryMode=0750
{{- end}}
WorkingDirectory={{.StateDir}}

# --- Hardening ---
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
{{- if .NeedsNetBind}}
# {{.Bind}} is a port below 1024, which needs this capability. A reverse proxy
# on 443 in front of a loopback listener would need neither.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
{{- else}}
CapabilityBoundingSet=
AmbientCapabilities=
{{- end}}
UMask=0027
ReadWritePaths={{.StateDir}}

[Install]
WantedBy=multi-user.target
