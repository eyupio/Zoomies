# systemd unit for a standalone Zoomies agent.
#
# Written by `zoomies agent join`. The agent connects outbound to the
# controller; nothing dials it, so no inbound firewall rule is needed.

[Unit]
Description={{.Description}}
Documentation=https://github.com/eyupio/zoomies
After=network-online.target
Wants=network-online.target
{{- if .WantsDocker}}
After=docker.service
Wants=docker.service
{{- end}}

[Service]
Type=notify
NotifyAccess=main
User={{.User}}
Group={{.Group}}
{{- if .SupplementaryGroups}}
SupplementaryGroups={{join .SupplementaryGroups " "}}
{{- end}}
ExecStart={{.ExecPath}} {{.Command}} --config {{.ConfigFile}}
Restart=always
RestartSec=5s
# Generous, because a graceful stop waits for in-flight jobs to finish.
TimeoutStopSec={{.StopTimeout}}
KillSignal=SIGTERM
# The main process only. The default, control-group, would send SIGTERM to
# every process in the unit's cgroup on a stop or restart -- with the process
# backend that is every runner and the job it is running. The agent is told to
# stop and waits for its jobs; the runners are not part of that conversation.
KillMode=process

{{- if .StandardDirs}}

StateDirectory=zoomies
StateDirectoryMode=0750
ConfigurationDirectory=zoomies
ConfigurationDirectoryMode=0750
{{- end}}
WorkingDirectory={{.StateDir}}

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027
ReadWritePaths={{.StateDir}}

[Install]
WantedBy=multi-user.target
