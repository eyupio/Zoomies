# Copy to .env and fill in. docker compose reads this automatically.

# Where GitHub and your browser reach this controller. Cloudflare terminates
# TLS in front of the origin, so this is https even though the container serves
# plain HTTP. Webhook deliveries go to $ZOOMIES_EXTERNAL_URL/webhooks/github.
ZOOMIES_EXTERNAL_URL=https://zoomies.sh

# 32 random bytes, base64 encoded:  openssl rand -base64 32
# Everything secret in the database is sealed with this. Back it up separately
# from the database itself -- losing it means re-entering the GitHub App
# private key and webhook secret.
ZOOMIES_ENCRYPTION_KEY=

# Cloudflare's published ranges. Without them the origin sees Cloudflare's
# address on every connection, so the audit log records Cloudflare for every
# action and the login rate limiter throttles the whole internet as one client.
#
# Refresh from https://www.cloudflare.com/ips/ when Cloudflare publishes a
# change; these were current when this file was written.
ZOOMIES_TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# How many runners this host may run at once.
ZOOMIES_AGENT_CAPACITY=4

# The gid of the docker group on the host:  getent group docker | cut -d: -f3
DOCKER_GID=999
