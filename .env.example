# Copy to .env and fill in. docker compose reads this automatically, and
# refuses to start until the three values marked (required) are set.

# (required) Where GitHub and your browser reach this controller. Cloudflare
# terminates TLS in front of the origin, so this is https even though the
# container serves plain HTTP. Webhook deliveries go to
# $ZOOMIES_EXTERNAL_URL/webhooks/github, and the GitHub App you create from the
# Installations page sends your browser back to $ZOOMIES_EXTERNAL_URL too, so
# it has to be the address you actually use, e.g. https://zoomies.example.com
ZOOMIES_EXTERNAL_URL=

# (required) 32 random bytes, base64 encoded:  openssl rand -base64 32
# Everything secret in the database is sealed with this. Back it up separately
# from the database itself -- losing it means re-entering the GitHub App
# private key and webhook secret.
ZOOMIES_ENCRYPTION_KEY=

# The word cloudflare expands to Cloudflare's published ranges, embedded in
# the binary and refreshed when it is. Without them the origin sees
# Cloudflare's address on every connection, so the audit log records
# Cloudflare for every action and the login rate limiter throttles the whole
# internet as one client.
ZOOMIES_TRUSTED_PROXIES=cloudflare

# How many runners this host may run at once.
ZOOMIES_AGENT_CAPACITY=4

# (required) The gid that owns the Docker socket on this host:
#
#     stat -c '%g' /var/run/docker.sock
#
# It is read from the socket rather than looked up by name because it is not
# always the group called docker: 987 on one distribution, 999 or 998 on
# another, and your own gid for a rootless daemon. The container runs as uid
# 65532 and is put in this group so that it can create runner containers. With
# the wrong number it comes up healthy and can start nothing; the Hosts page
# then says which group it holds and which line to change, and
# `docker compose up -d` recreates it.
#
# If stat prints 0 the socket belongs to root's group, and the answer is not
# to put the container in it: give the socket a group of its own (sudo groupadd
# docker, then restart the daemon so it takes the group) or use a rootless
# daemon, and come back for the number.
DOCKER_GID=
