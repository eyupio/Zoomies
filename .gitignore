# Build output
/zoomies
/dist/
/bin/
*.test
coverage.out

# Embedded UI build product (generated by `make ui`)
/internal/api/webdist/
/web/node_modules/
/web/.svelte-kit/
/web/dist/
/web/test-results/
/web/playwright-report/
/web/blob-report/

# Local state
*.db
*.db-shm
*.db-wal
/zoomies.yaml
/encryption.key
/.zoomies/*
!/.zoomies/AI_CONTEXT.md
# The documented first step is `cp .env.example .env`, and what goes in it is
# ZOOMIES_ENCRYPTION_KEY -- the key everything secret in the database is sealed
# with. .env.example is the one that belongs in git.
/.env
# The compose deployment's state: the database and the runners' work area.
/data/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# The built website (mkdocs build)
/site/

# Python bytecode from the site build hook
__pycache__/

# Per-run end-to-end scenario results. The harness writes one JSON file per
# scenario per run (see test/e2e/README.md); the records are evidence about a
# run, not about the tree.
roadmap/validation/e2e/
