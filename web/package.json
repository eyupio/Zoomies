{
  "name": "zoomies-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "The Zoomies operator UI. Built with Vite and embedded into the Go binary.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode status",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts",
    "test:e2e": "playwright test",
    "test:unit": "node --import ./unit/register.mjs --test unit/*.test.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.47.0",
    "@tanstack/svelte-table": "^9.2.4",
    "@tanstack/table-core": "^9.2.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
